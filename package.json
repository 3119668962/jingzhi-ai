{
  "name": "jingzhi-ai",
  "productName": "竞智AI",
  "version": "2.0.0",
  "description": "大学生个性化竞赛智能推荐与成长规划平台",
  "private": true,
  "main": "electron/main.cjs",
  "author": "竞智AI",
  "license": "UNLICENSED",
  "scripts": {
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "electron . --dev",
    "dev": "concurrently -k \"npm:dev:vite\" \"wait-on http://127.0.0.1:5173 && npm:dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder --win portable",
    "dist:dir": "vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "ai.jingzhi.desktop",
    "productName": "竞智AI",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "竞智AI-${version}-win-x64.${ext}"
    },
    "portable": {
      "artifactName": "竞智AI-${version}-便携版.${ext}"
    }
  }
}
